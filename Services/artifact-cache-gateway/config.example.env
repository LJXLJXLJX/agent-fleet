ARTIFACT_CACHE_STORAGE="s3"
ARTIFACT_CACHE_DIR="/data/artifact-cache"
ARTIFACT_CACHE_CONFIG="config/sources.json"
ARTIFACT_CACHE_S3_ENDPOINT="http://<s3-endpoint>"
ARTIFACT_CACHE_S3_REGION="<region>"
ARTIFACT_CACHE_S3_BUCKET="<bucket>"
ARTIFACT_CACHE_S3_PREFIX="artifact-cache-gateway"
ARTIFACT_CACHE_S3_ACCESS_KEY_ID="<access-key-id>"
ARTIFACT_CACHE_S3_SECRET_ACCESS_KEY="<secret-access-key>"
# ARTIFACT_CACHE_S3_SESSION_TOKEN="<session-token>"
# ARTIFACT_CACHE_UPSTREAM_PROXY="http://<proxy-host>:<proxy-port>"
ARTIFACT_CACHE_CACHE_MODE="proxy-only"
# Optional GitHub prewarm/readiness plan. It is not a runtime repository allowlist.
# Bare mirrors live on a persistent filesystem.
# ARTIFACT_CACHE_GIT_MIRROR_PLAN="/path/to/git-mirror-plan.json"
ARTIFACT_CACHE_GIT_MIRROR_ROOT="/data/artifact-cache/github_mirrors"

# Dataset image pre-upload (artifact-cache-prepare). Keep real credentials only
# in the Git-ignored config.local.env.
YICLOUD_HARBOR_HOST="<internal-registry-host>"
YICLOUD_HARBOR_USERNAME="<registry-username>"
YICLOUD_HARBOR_PASSWORD="<registry-password>"
# ARTIFACT_MIRROR_REGISTRY="<override-registry-host>"
ARTIFACT_MIRROR_PROJECT="public-mirror"
ARTIFACT_MIRROR_PLATFORM="linux/amd64"
ARTIFACT_MIRROR_SOURCE_PREFIX_MAP_JSON='{"docker.io":["docker.m.daocloud.io","docker.1ms.run","docker.1panel.live","docker.xuanyuan.me"],"mcr.microsoft.com":"m.daocloud.io/mcr.microsoft.com"}'
ARTIFACT_MIRROR_TARGET_TLS_VERIFY="true"
ARTIFACT_MIRROR_CONCURRENCY="4"
# ARTIFACT_MIRROR_UPSTREAM_PROXY="http://<proxy-host>:<proxy-port>"
# ARTIFACT_MIRROR_DIRECT_UPSTREAM_WITH_PROXY="true"
